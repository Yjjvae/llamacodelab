name: ci

on:
  pull_request:
  push:
    branches: [{{DEFAULT_BRANCH}}]
  workflow_dispatch:

concurrency:
  group: ci-${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  changes:
    name: changes
    runs-on: {{RUNNER}}
    timeout-minutes: 5
    outputs:
      code: ${{ steps.scope.outputs.code }}
    steps:
      - uses: actions/checkout@{{CHECKOUT_REF}}
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Classify change scope
        id: scope
        env:
          EVENT_NAME: ${{ github.event_name }}
          BASE_SHA: ${{ github.event.pull_request.base.sha || github.event.before }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
        run: |
          set -euo pipefail

          if [[ "$EVENT_NAME" == "workflow_dispatch" ]]; then
            echo "code=true" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          if [[ -z "$BASE_SHA" || "$BASE_SHA" =~ ^0+$ ]]; then
            echo "code=true" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          code=false
          while IFS= read -r -d '' path; do
            case "$path" in
              *.md|docs/*|LICENSE|LICENSE.*) ;;
              *)
                code=true
                break
                ;;
            esac
          done < <(git diff --name-only -z "$BASE_SHA" "$HEAD_SHA")

          git diff --check "$BASE_SHA" "$HEAD_SHA"
          echo "code=$code" >> "$GITHUB_OUTPUT"
          echo "Full quality job required: $code" >> "$GITHUB_STEP_SUMMARY"

  quality:
    name: quality
    needs: changes
    if: needs.changes.outputs.code == 'true'
    runs-on: {{RUNNER}}
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@{{CHECKOUT_REF}}
        with:
          submodules: {{CHECKOUT_SUBMODULES}}
          persist-credentials: false
      - name: Run project quality gate
        run: |
          {{QUALITY_COMMAND}}

  required:
    name: required
    if: always()
    needs: [changes, quality]
    runs-on: {{RUNNER}}
    timeout-minutes: 5
    steps:
      - name: Verify required jobs
        env:
          CHANGES_RESULT: ${{ needs.changes.result }}
          QUALITY_RESULT: ${{ needs.quality.result }}
        run: |
          set -euo pipefail
          for result in "$CHANGES_RESULT" "$QUALITY_RESULT"; do
            case "$result" in
              success|skipped) ;;
              *) exit 1 ;;
            esac
          done
